# TVXO release signing (copy to keystore.properties, which is gitignored).
# Paths are relative to the project root. Environment variables override these:
#   TVXO_KEYSTORE_FILE, TVXO_KEYSTORE_PASSWORD, TVXO_KEY_ALIAS, TVXO_KEY_PASSWORD
storeFile=tvxo-release.jks
storePassword=CHANGE_ME
keyAlias=tvxo
keyPassword=CHANGE_ME
